# =============================================================
#  Wiztant — Environment Configuration Example
#  Copy this file to .env and fill in your actual API keys.
#  DO NOT commit .env to version control.
# =============================================================

# ── Speech-to-Text (STT) ──────────────────────────────────
# Groq API key for cloud-based Whisper Large v3 Turbo
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# ── LLM & Agent ───────────────────────────────────────────
# OpenAI-compatible API key (used with OpenRouter)
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# OpenRouter API key for UI-TARS agent (1.5 7B) and GPT-5.4
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_KEY_HERE

# ── Backend Services ──────────────────────────────────────
# Supabase project credentials (auth, user data, insights)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Helicone proxy API key (for LLM usage tracking & logging)
HELICONE_API_KEY=sk-helicone-YOUR_KEY_HERE

# LemonSqueezy API key (for license validation)
LEMONSQUEEZY_API_KEY=YOUR_LEMONSQUEEZY_KEY_HERE

# ── Application Settings ──────────────────────────────────
# Current user tier (free, pro, power)
CURRENT_TIER=free

# Enable debug mode (verbose logging, local dev features)
DEBUG=false

# Linux system environment (optional, auto-detected)
# XDG_CONFIG_HOME=/home/user/.config
